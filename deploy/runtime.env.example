# Copy to deploy/runtime.env (git ignores it), or store the same lines in the RUNTIME_ENV
# GitHub environment secret. One KEY=value per line, no quotes. Everything is optional in demo
# mode; live mode needs sign-in and PostgreSQL. See docs/operations.md.

# Sign-in through the workspace auth service. The key equals TEVA_AUTH_DELIVERY_KEY there.
DELIVERY_AUTH_URL=http://teva-auth:8002
DELIVERY_AUTH_SERVICE_KEY=

# PostgreSQL (live mode).
DELIVERY_POSTGRES_HOST=
DELIVERY_POSTGRES_DATABASE=delivery
DELIVERY_POSTGRES_USER=delivery
DELIVERY_POSTGRES_PASSWORD=

# Konimbo. Writes stay off (recorded as "test mode") until DELIVERY_KONIMBO_WRITES=true.
DELIVERY_KONIMBO_TOKEN=
DELIVERY_KONIMBO_WRITES=false
# The status whose change makes Konimbo send the order to Cargo, and when the service sets it
# (claim, complete or off). Status names can also be changed on the settings screen.
DELIVERY_KONIMBO_STATUS_TRANSMIT=
DELIVERY_TRANSMIT_ON=complete

# Cargo: needed for label links. The service creates shipments itself only with
# DELIVERY_SHIPMENT_SOURCE=cargo and DELIVERY_CARGO_WRITES=true.
DELIVERY_CARGO_TOKEN=
DELIVERY_CARGO_CUSTOMER_CODE_EXPRESS=

# Labels through teva-printer, with the employee's own session.
DELIVERY_PRINTER_URL=http://teva-printer:8000
DELIVERY_LABEL_PRINTER_ID=

# Voice: local speech recognition (deploy/compose.stt.yml) and the optional AI interpreter.
DELIVERY_STT_URL=
DELIVERY_AI_PROVIDER=none
DELIVERY_ANTHROPIC_API_KEY=

DELIVERY_LOG_FORMAT=json
